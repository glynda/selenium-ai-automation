<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Full Regression Suite" verbose="1">
    <test name="Positive Login Tests in chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.practicetestautomation.tests.login.LoginTests">
                <methods>
                    <include name="loginFunctionalityTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Positive Login Tests in firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.practicetestautomation.tests.login.LoginTests">
                <methods>
                    <include name="loginFunctionalityTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Invalid Username Test">
        <parameter name="browser" value="firefox"/>
        <parameter name="username" value="invalidUsername"/>
        <parameter name="password" value="Password123"/>
        <parameter name="expectedErrorMessage" value="Your username is invalid!"/>
        <classes>
            <class name="com.practicetestautomation.tests.login.LoginTests">
                <methods>
                    <include name="negativeLoginTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Invalid Password Test">
        <parameter name="browser" value="safari"/>
        <parameter name="username" value="student"/>
        <parameter name="password" value="invalidPassword"/>
        <parameter name="expectedErrorMessage" value="Your password is invalid!"/>
        <classes>
            <class name="com.practicetestautomation.tests.login.LoginTests">
                <methods>
                    <include name="negativeLoginTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Exceptions Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.practicetestautomation.tests.exceptions.ExceptionsTests"/>
        </classes>
    </test>
    <test name="Table Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.practicetestautomation.tests.table.TableTests"/>
        </classes>
    </test>
</suite>